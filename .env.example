# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 마세요.
#
# 로그인은 Google 계정만 지원합니다. 아이디/비밀번호 로그인은 제거됐습니다.
# 아래 설정이 불완전하면 서버가 기동을 거부합니다 — 로그인할 수 없는 상태로
# 서비스가 떠 있는 것보다 즉시 실패하는 편이 안전하기 때문입니다.

# --- Google OAuth 클라이언트 (필수) ---
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서
# "OAuth 2.0 클라이언트 ID"(웹 애플리케이션)를 만들고,
# 승인된 리디렉션 URI에 아래 GOOGLE_REDIRECT_URI와 같은 값을 등록하세요.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 로그인 허용 계정 (둘 중 하나 이상 필수) ---
# 여기 없는 Google 계정은 로그인할 수 없습니다. 쉼표로 여러 개 나열 가능.
# 이 값은 환경변수로만 바꿀 수 있습니다(UI에서 변경 불가) — 세션이 탈취돼도
# 공격자가 자기 계정을 허용 목록에 추가할 수 없도록 한 의도적 제약입니다.
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAINS=

# --- 리디렉션 URI (선택) ---
# 비워두면 요청 호스트에서 유추합니다. 리버스 프록시 뒤에서는 명시하세요.
# Google 제약: http는 localhost만 허용, 사설 IP와 IP 주소는 등록 불가.
# 예: https://ssh.example.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- 기타 ---
# HTTPS 리버스 프록시 뒤에서 운영할 때 true
COOKIE_SECURE=false
